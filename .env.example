# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# LLM 선택: gemini(클라우드) 또는 ollama(이 PC·법인 서버에서 실행, 문서가 밖으로 나가지 않음)
LLM_PROVIDER=gemini

# Gemini (LLM_PROVIDER=gemini일 때)
GEMINI_API=
# 요청 분류·서식 해석·조회(기본: Lite)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# 문서 추출(기본: Lite. 정확도가 부족하면 이것만 Flash로 올린다)
# GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
# GEMINI_EXTRACTION_FALLBACK_MODELS=gemini-3.1-flash-lite

# Ollama (LLM_PROVIDER=gemini일 때)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:e4b
# GPU 드라이버가 맞지 않으면 0(CPU만 사용). 비우면 Ollama가 정한다.
# OLLAMA_NUM_GPU=0

# DB (docker-compose.yml의 개발용 PostgreSQL)
# DATABASE_URL=postgresql+psycopg://lawca:lawca@localhost:5433/lawca

# 로그인 쿠키를 HTTPS에서만 보낸다. 운영(HTTPS)에서는 true
# COOKIE_SECURE=false
# 로그인 유지 시간(시간, 1~720). 지나면 다시 로그인합니다. 기본 12.
# SESSION_HOURS=12

# 자료실 검색 임베딩(로컬 Ollama). ollama pull bge-m3
# EMBEDDING_MODEL=bge-m3
# EMBEDDINGS_ENABLED=true

# 국가법령정보센터 Open API 인증키(OC). 준비서면의 판례 후보 찾기에 쓴다
# LAW_API=
